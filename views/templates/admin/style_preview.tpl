<div class="ib-style-live" id="ib-style-live">
  <div class="ib-style-live-box">
    <div class="ib-style-live-label">{$ib_label_desktop|escape:'html':'UTF-8'}</div>
    <span class="ib-checker"><span class="ib-style-sample" data-device="desktop">{$ib_sample|escape:'html':'UTF-8'}</span></span>
  </div>
  <div class="ib-style-live-box ib-style-live-mobile">
    <div class="ib-style-live-label">{$ib_label_mobile|escape:'html':'UTF-8'}</div>
    <span class="ib-checker"><span class="ib-style-sample" data-device="mobile">{$ib_sample|escape:'html':'UTF-8'}</span></span>
  </div>
  <div class="alert alert-warning ib-contrast-warning" style="display:none">{$ib_contrast_warning|escape:'html':'UTF-8'}</div>
  <div class="alert alert-info ib-translucent-note" style="display:none">{$ib_translucent_note|escape:'html':'UTF-8'}</div>
</div>
